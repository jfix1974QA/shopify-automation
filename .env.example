# Your storefront URL (no trailing slash)
STORE_URL=https://your-store.myshopify.com

# Only if the store is password protected
STORE_PASSWORD=

# Enables the Claude features (visual checks, self-healing, generator, copy review).
# Without it, @ai tests are skipped and everything else still runs.
ANTHROPIC_API_KEY=

# AI_MODEL=claude-opus-5-5
# AI_SELF_HEAL=true
